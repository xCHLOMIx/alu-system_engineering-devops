#!/usr/bin/env bash
#Setting up nginx on a server
sudo apt -y install nginx
nginx="events {}
http {
	server {
		listen 80;
		root /var/www/html/;
		index index.html;
	}
}"
sudo chmod 777 -R /var/www/html/index.html
echo "Holberton School for the win!" > /var/www/html/index.html
sudo chmod 777 -R /etc/nginx/nginx.conf
sudo echo $nginx > /etc/nginx/nginx.conf
sudo nginx
sudo nginx -s reload
